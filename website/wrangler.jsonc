// Cloudflare Workers static assets: the pre-rendered site in ./dist, with no Worker script (no `main`), so every
// request is served straight from Cloudflare's asset store.
// `wrangler deploy` publishes to production: it creates the Worker and attaches voicepipes.app as its Custom
// Domain, which makes Cloudflare create the DNS record and certificate. Run it only for an approved release of
// the site (README → Hosting). The account comes from the Wrangler login (`account_id` is unset).
// `wrangler preview` publishes a Preview instead, on workers.dev only: Previews never take over routes or custom
// domains, and voicepipes.app is kept out of them (`previews_enabled: false`).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voice-pipes-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "voicepipes.app", "custom_domain": true, "previews_enabled": false }],
  // Production is served on voicepipes.app only; Previews get <preview>-voice-pipes-website.<subdomain>.workers.dev.
  "workers_dev": false,
  "preview_urls": true,
  // A static site has no bindings or variables, so Previews need no settings of their own.
  "previews": {}
}
