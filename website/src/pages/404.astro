---
// Served by Cloudflare for any path without a page (wrangler.jsonc: not_found_handling "404-page").
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Voice Pipes" noindex>
  <main id="main" class="band" style="min-height: 100vh">
    <div class="wrap hero__body">
      <h1 class="display h2">page not found<span class="c-pink">.</span></h1>
      <div class="actions">
        <a class="btn btn-p" href="/">Go to the home page</a>
      </div>
    </div>
  </main>
</Base>
