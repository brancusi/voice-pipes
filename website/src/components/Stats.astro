---
// Each figure is measured in docs/research.md or set in the app (History keeps 1,000 runs: HistoryStore.limit).
const stats = [
  ['~0.1 s', 'from letting go to text, with Parakeet on your Mac (40–140 ms for 4–33 s of speech)'],
  ['0.26 s', "for Jev to pick a route; 15 of 15 test questions went where we'd send them"],
  ['~25 ms', 'to the first sound when Pocket TTS reads aloud, streaming as it speaks'],
  ['1,000', 'takes kept in History, searchable, so a dictation that missed its window isn’t lost'],
];
---

<section class="sec sec--deep">
  <div class="wrap g4 stats">
    {
      stats.map(([figure, what]) => (
        <div>
          <span class="stat">{figure}</span>
          <span class="small">{what}</span>
        </div>
      ))
    }
  </div>
</section>
