---
// Steps the illustrative figures in blog posts (<figure data-flow>): each [data-step="n"] element appears at stage n,
// and the newest flashes, like the app outlining what changed. Without JavaScript, or with reduced motion, every step
// shows at once (the finished state). It runs only while the figure is on screen and the tab is visible, and the
// figure's own Pause and Replay buttons control it. Nothing here touches the microphone, speakers or network.
// A figure can also change state from stage to stage: the figure carries data-stage="n" (in the markup, the
// finished stage, so that is what shows without JavaScript), and the styles below match space-separated stage lists:
// data-on (shown only at those stages), data-cur and data-done (a read-along sentence being read, or already read),
// data-ul (the word under the cursor), data-hov (the pointer over it) and data-lit (a control or note in use).
---

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  for (const fig of document.querySelectorAll<HTMLElement>('[data-flow]')) {
    const steps = [...fig.querySelectorAll<HTMLElement>('[data-step]')];
    // The finished stage: data-stage in the markup, else the highest data-step.
    const last = Number(fig.dataset.stage ?? Math.max(...steps.map((el) => Number(el.dataset.step))));
    const controls = fig.querySelector<HTMLElement>('[data-flow-controls]');
    const pause = fig.querySelector<HTMLButtonElement>('[data-flow-pause]');
    let stage = last, timer = 0, held = false, inView = false;

    const show = (s: number) => {
      stage = s;
      fig.dataset.stage = String(s);
      for (const el of steps) {
        const n = Number(el.dataset.step);
        el.toggleAttribute('data-off', n > s);
        el.toggleAttribute('data-now', n === s && s < last);
      }
    };
    const playing = () => !held && inView && !document.hidden && !reduce.matches;
    const run = () => {
      clearTimeout(timer);
      if (playing()) timer = window.setTimeout(() => { show(stage >= last ? 0 : stage + 1); run(); }, stage >= last ? 4200 : 1500);
    };
    const restart = () => { show(reduce.matches ? last : 0); run(); };

    if (controls) controls.hidden = reduce.matches;
    pause?.addEventListener('click', () => {
      held = !held;
      pause.setAttribute('aria-pressed', String(held));
      pause.textContent = held ? 'Play' : 'Pause';
      run();
    });
    fig.querySelector('[data-flow-replay]')?.addEventListener('click', restart);
    reduce.addEventListener('change', () => { if (controls) controls.hidden = reduce.matches; restart(); });
    document.addEventListener('visibilitychange', run);
    let started = false;
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView && !started) { started = true; restart(); } else run();
    }).observe(fig);
  }
</script>

<style is:global>
  /* Stage lists (see above), for stages 0 to 7. Only blog posts load these styles. */
  [data-stage="0"] [data-on]:not([data-on~="0"]),
  [data-stage="1"] [data-on]:not([data-on~="1"]),
  [data-stage="2"] [data-on]:not([data-on~="2"]),
  [data-stage="3"] [data-on]:not([data-on~="3"]),
  [data-stage="4"] [data-on]:not([data-on~="4"]),
  [data-stage="5"] [data-on]:not([data-on~="5"]),
  [data-stage="6"] [data-on]:not([data-on~="6"]),
  [data-stage="7"] [data-on]:not([data-on~="7"]) {
    display: none;
  }
  [data-stage="0"] [data-cur~="0"],
  [data-stage="1"] [data-cur~="1"],
  [data-stage="2"] [data-cur~="2"],
  [data-stage="3"] [data-cur~="3"],
  [data-stage="4"] [data-cur~="4"],
  [data-stage="5"] [data-cur~="5"],
  [data-stage="6"] [data-cur~="6"],
  [data-stage="7"] [data-cur~="7"] {
    --bar: var(--purple);
    color: var(--fg);
  }
  [data-stage="0"] [data-done~="0"],
  [data-stage="1"] [data-done~="1"],
  [data-stage="2"] [data-done~="2"],
  [data-stage="3"] [data-done~="3"],
  [data-stage="4"] [data-done~="4"],
  [data-stage="5"] [data-done~="5"],
  [data-stage="6"] [data-done~="6"],
  [data-stage="7"] [data-done~="7"] {
    color: rgba(184, 168, 142, 0.6);
  }
  [data-stage="0"] [data-cur~="0"] [data-ul~="0"],
  [data-stage="1"] [data-cur~="1"] [data-ul~="1"],
  [data-stage="2"] [data-cur~="2"] [data-ul~="2"],
  [data-stage="3"] [data-cur~="3"] [data-ul~="3"],
  [data-stage="4"] [data-cur~="4"] [data-ul~="4"],
  [data-stage="5"] [data-cur~="5"] [data-ul~="5"],
  [data-stage="6"] [data-cur~="6"] [data-ul~="6"],
  [data-stage="7"] [data-cur~="7"] [data-ul~="7"] {
    text-decoration: underline 1px var(--purple);
    text-underline-offset: 3px;
  }
  [data-stage="0"] [data-hov~="0"],
  [data-stage="1"] [data-hov~="1"],
  [data-stage="2"] [data-hov~="2"],
  [data-stage="3"] [data-hov~="3"],
  [data-stage="4"] [data-hov~="4"],
  [data-stage="5"] [data-hov~="5"],
  [data-stage="6"] [data-hov~="6"],
  [data-stage="7"] [data-hov~="7"] {
    background: rgba(240, 228, 204, 0.07);
  }
  [data-stage="0"] [data-lit~="0"],
  [data-stage="1"] [data-lit~="1"],
  [data-stage="2"] [data-lit~="2"],
  [data-stage="3"] [data-lit~="3"],
  [data-stage="4"] [data-lit~="4"],
  [data-stage="5"] [data-lit~="5"],
  [data-stage="6"] [data-lit~="6"],
  [data-stage="7"] [data-lit~="7"] {
    --lit-bg: var(--purple);
    --lit-fg: var(--on-accent);
    color: var(--fg);
  }

  /* The read-along card and HUD tag, as drawn in the app's HUD.swift (ReadAlongCard, HUDTag, PlaybackControls) */
  .ra { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .ra__card { box-sizing: border-box; width: 100%; max-width: 500px; background: var(--hud-bg); border: 1px solid rgba(240, 228, 204, 0.14); border-radius: 2px; font-size: 12px; line-height: 18px; }
  .ra__text { padding: 10px 12px; display: flex; flex-direction: column; gap: 5px; }
  .ra__s { position: relative; margin: 0; padding: 1px 4px 1px 10px; border-radius: 2px; color: rgba(240, 228, 204, 0.7); }
  .ra__s::before { content: ''; position: absolute; left: 0; top: 2px; bottom: 2px; width: 2px; background: var(--bar, transparent); }
  .ra__s--para { margin-top: 7px; }
  .ra__foot { display: flex; align-items: center; gap: 8px; height: 26px; padding: 0 10px; border-top: 1px solid rgba(240, 228, 204, 0.1); font-size: 11px; color: var(--fg-muted); }
  .ra__voice { margin-right: auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ra__rate { width: 4ch; text-align: center; color: var(--fg); }
  .ra__btn { display: inline-grid; place-items: center; width: 20px; height: 16px; border-radius: 2px; background: var(--lit-bg, rgba(240, 228, 204, 0.14)); color: var(--lit-fg, var(--fg)); font-size: 10px; line-height: 1; }
  .ra__tag .ra__btn { margin-left: -5px; }
  .ra__tag .c-muted + .ra__btn { margin-left: 2px; }
  .prose .ra__keys { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 12px; line-height: 18px; color: var(--fg-muted); }
  .prose .ra__keys li { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .ra__keys .key { gap: 5px; background: var(--lit-bg, var(--bg-300)); color: var(--lit-fg, var(--fg-muted)); }

  /* A small read-along card above a HUD tag */
  .fig__stack { align-self: flex-start; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .fig__mini { display: flex; flex-direction: column; gap: 5px; width: 170px; padding: 7px 8px 7px 14px; background: var(--hud-bg); border: 1px solid rgba(240, 228, 204, 0.14); border-radius: 2px; }
  .fig__mini-line { height: 4px; border-radius: 1px; background: rgba(240, 228, 204, 0.25); }
  .fig__mini-line:nth-child(2) { width: 80%; }
  .fig__mini-line:nth-child(3) { width: 60%; }
  .fig__mini-line--now { position: relative; background: var(--fg-muted); }
  .fig__mini-line--now::before { content: ''; position: absolute; left: -7px; top: -2px; bottom: -2px; width: 2px; background: var(--purple); }

  /* "Treat audio like a page" (rk-): static frames of the read-along card with the HUD holding the keys, as drawn in
     HUD.swift (ReadAlongCard's KEYS ON foot, HUDTag's KEYS mark), who has the keyboard in each mode, and
     Setup → Reading as drawn in SetupView.swift (ReadingSettingsSection). The frames reuse the .ra styles above at
     data-stage="0". Only that post uses these classes. */
  .prose kbd:not(.key) { padding: 0 4px; border-radius: 2px; background: var(--bg-300); color: var(--fg); font: inherit; font-size: 0.92em; }
  .rk-win { padding-block: 14px; -webkit-mask-image: linear-gradient(transparent, #000 12px, #000 calc(100% - 12px), transparent); mask-image: linear-gradient(transparent, #000 12px, #000 calc(100% - 12px), transparent); }
  .rk-ahead { color: rgba(240, 228, 204, 0.82); }
  .rk-on { flex: none; font-size: 10px; font-weight: 700; color: var(--purple); }
  .rk-hint { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 10px; color: var(--fg-muted); }
  .rk-hint span { color: var(--fg); }
  .rk-keys { display: inline-flex; align-items: center; height: 16px; padding: 0 5px; margin-left: 2px; box-sizing: border-box; border: 1px solid var(--purple); border-radius: 2px; color: var(--purple); font-size: 9px; font-weight: 700; }
  .rk-legend .rk-sw { width: 2px; height: 16px; background: var(--purple); }
  .rk-legend .rk-ul { color: var(--fg); text-decoration: underline 1px var(--purple); text-underline-offset: 3px; }
  .rk-legend .rk-on { font-size: 11px; }
  .prose .rk-story { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .prose .rk-story > li { margin: 0; }
  .rk-scene { min-width: 0; padding: 14px; display: flex; flex-direction: column; gap: 12px; }
  .rk-scene__head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13px; line-height: 20px; }
  .rk-scene__head .key { margin-left: auto; color: var(--fg); }
  .rk-n { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 2px; background: var(--purple); color: var(--on-accent); font-size: 11px; font-weight: 700; }
  .rk-table { overflow-x: auto; }
  .prose .rk-modes { display: table; width: 100%; border-collapse: collapse; font-size: 13px; line-height: 18px; }
  .prose .rk-modes th,
  .prose .rk-modes td { padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .prose .rk-modes th { font-size: 12px; letter-spacing: 0; text-transform: none; }
  .prose .rk-modes thead th { color: var(--fg); text-align: center; vertical-align: bottom; }
  .prose .rk-modes thead th:first-child,
  .prose .rk-modes tbody th { color: var(--fg-muted); font-weight: 400; text-align: left; }
  .prose .rk-modes td { text-align: center; color: var(--fg-muted); }
  .prose .rk-modes td.rk-hud { color: var(--purple); font-weight: 700; background: rgba(195, 163, 212, 0.14); }
  .rk-setup { background: var(--bg-100); gap: 6px; }
  .rk-section { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-muted); }
  .rk-panel { display: flex; flex-direction: column; gap: 14px; padding: 16px; background: var(--bg-200); border: 1px solid var(--line); border-radius: 6px; }
  .rk-group { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .rk-strong { font-size: 13px; font-weight: 600; color: var(--fg); }
  .rk-cap { font-size: 11px; line-height: 16px; color: var(--fg-muted); }
  .rk-seg { display: inline-flex; flex-wrap: wrap; gap: 2px; padding: 2px; background: var(--bg-000); border: 1px solid var(--line); border-radius: 4px; }
  .rk-seg > span { display: inline-flex; align-items: center; height: 22px; padding: 0 10px; border-radius: 2px; font-size: 12px; color: var(--fg-muted); white-space: nowrap; }
  .rk-seg > .rk-seg__on { background: var(--purple); color: var(--on-accent); font-weight: 600; }
  .rk-rule { height: 1px; background: var(--line); }
  .rk-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; }
  .rk-reset { font-size: 13px; font-weight: 600; color: var(--comment); }
  .rk-act { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 6px 12px; align-items: center; }
  .rk-act__label { font-size: 11px; color: var(--fg-muted); }
  .rk-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .rk-chip { display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 4px 0 8px; box-sizing: border-box; background: var(--bg-300); border: 1px solid var(--line); border-radius: 2px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; color: var(--fg); }
  .rk-chip i { width: 16px; font-style: normal; font-size: 10px; text-align: center; color: var(--fg-muted); }
  .rk-add { display: inline-flex; align-items: center; height: 22px; padding: 0 8px; box-sizing: border-box; border: 1px solid var(--line); border-radius: 2px; font-size: 12px; font-weight: 600; color: var(--purple); }
  .rk-link { font-size: 13px; font-weight: 600; color: var(--purple); }
  @media (max-width: 640px) {
    .prose .rk-story { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 520px) {
    .prose .rk-modes th,
    .prose .rk-modes td { padding: 6px 4px; }
    .prose .rk-modes { font-size: 12px; }
    .rk-panel { padding: 12px; }
    .rk-act { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 400px) {
    .prose .rk-modes th,
    .prose .rk-modes td { padding: 6px 3px; font-size: 11px; }
  }
</style>
