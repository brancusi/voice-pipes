---
import Logo from './Logo.astro';
import { DOWNLOAD_URL } from '../site';

// Absolute, so they work from /setup too (on the home page they stay same-page jumps).
const sections = [
  ['/#tracks', 'Tracks'],
  ['/#blocks', 'Building blocks'],
  ['/#routing', 'Routing'],
  ['/#local', 'On your Mac'],
  ['/#changelog', 'Changelog'],
  ['/setup', 'Setup'],
];
// Marks Docs or Blog as the current section on its pages (built as docs/cli.html and the like).
const path = Astro.url.pathname.replace(/\.html$/, '');
const here = (section: string) => (path === section ? 'page' : path.startsWith(`${section}/`) ? 'true' : undefined);
---

<header class="band">
  <div class="wrap site-header__bar">
    <a class="brand" href="/#top" aria-label="Voice Pipes home">
      <Logo size={32} />
      <span class="wordmark">voice <span class="c-pink">|</span> pipes</span>
    </a>
    <nav class="navlinks" aria-label="Sections">
      {sections.map(([href, label]) => <a class="nav-a" href={href}>{label}</a>)}
    </nav>
    <span class="spacer"></span>
    {/* Kept on every screen size, unlike the section links. */}
    <nav class="devlinks" aria-label="Developers">
      <a class="nav-a" href="/docs" aria-current={here('/docs')}>Docs</a>
      <a class="nav-a" href="/blog" aria-current={here('/blog')}>Blog</a>
    </nav>
    <a class="btn btn-p btn-sm" href={DOWNLOAD_URL}>Download</a>
  </div>
</header>
