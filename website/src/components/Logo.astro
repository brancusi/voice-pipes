---
// The mark in one colour (the text colour; 18 × 18 grid), drawn at whole-pixel sizes only: 36, 54, 72…
import glyph from '../assets/brand/voicepipes-glyph.svg?raw';
import { svgParts } from '../lib/svg';

interface Props {
  size: 36 | 54 | 72;
}
const { size } = Astro.props;
const { viewBox, inner } = svgParts(glyph);
---

<svg width={size} height={size} viewBox={viewBox} shape-rendering="crispEdges" aria-hidden="true" set:html={inner} />
