# Response headers for Cloudflare Workers static assets; this file is parsed at deploy time, not served.
# https://developers.cloudflare.com/workers/static-assets/headers/
# HTML keeps Cloudflare's default (Cache-Control: public, max-age=0, must-revalidate, plus an ETag).

# Astro fingerprints everything it emits under /_astro/, so a changed file always gets a new name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the workers.dev hosts (production and previews) out of search results.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
